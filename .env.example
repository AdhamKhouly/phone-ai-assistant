# Copy to .env (git-ignored) and fill in. Never commit .env.
DISCORD_TOKEN=
OWNER_USER_ID=
GUILD_ID=
ASSISTANT_CHANNEL_ID=
CALLS_CHANNEL_ID=
# simulated             = test calls only
# digits_native_observe = native DIGITS Mac app -> Discord, observe-only (cannot answer). Recommended.
# digits_native_answer  = native app + manual `answer` (also needs ALLOW_REAL_ANSWER=yes)
# digits_observe / digits_answer = older Chrome web-client versions, kept as a fallback
PHONE_BACKEND=simulated
# Seconds after ringing starts during which `answer` is accepted (carrier voicemail usually picks up ~20-30s).
ANSWER_WINDOW_SECONDS=22
# Commands older than this (Discord timestamp) are rejected as stale.
MAX_COMMAND_AGE_SECONDS=15
# Real answering needs BOTH: PHONE_BACKEND=digits_native_answer (or digits_answer) AND ALLOW_REAL_ANSWER=yes
ALLOW_REAL_ANSWER=no
# AI-handled calls are force-ended after this many seconds (safety net while there is no AI voice)
# 0 = no limit: the call ends when the caller hangs up, you type hangup, or after about 30 s of silence.
MAX_CALL_SECONDS=60
# Native backends reopen the DIGITS app if it isn't running (never answers anything). 'no' to disable.
DIGITS_AUTOLAUNCH=yes

# ---- Phase 3: call audio (only used with PHONE_BACKEND=digits_native_answer) ----
# What the assistant does on a call you answered with `answer`:
#   off           silence on the virtual microphone (default)
#   greeting      one fixed sentence, no listening          (needs ALLOW_AI_VOICE=yes)
#   conversation  full local AI conversation                (needs ALLOW_AI_VOICE=yes and your separate approval)
VOICE_MODE=off
# ALLOW_AI_VOICE=yes
# What #calls receives after an AI conversation:
#   categories  fixed phrases only (caller type, purpose); nothing that was said
#   detailed    a short note paraphrased by the local model (who called, what they wanted, any message).
#               It is sent to your private Discord channel and not saved on the Mac.
CALL_SUMMARY=categories
# Outgoing calls: `call <number>: <what the call is for, plus any details the AI may share on this call>`
# then `confirm`. Needs digits_native_answer + VOICE_MODE=conversation. Nothing is dialled without `confirm`.
# ALLOW_OUTGOING=yes
# Optional opening line (default: the built-in greeting)
# VOICE_GREETING="..."
# The two virtual audio devices (install BlackHole 2ch and 16ch). A call is never answered without them.
AUDIO_MIC_DEVICE=BlackHole 2ch
AUDIO_CAPTURE_DEVICE=BlackHole 16ch
# Optional model choices (defaults shown)
# VOICE_LLM_MODEL=qwen3:8b
# VOICE_TTS_MODEL=kokoro-v1.0.int8.onnx
# VOICE_NAME=af_heart
# VOICE_STT_MODEL=ggml-base.en.bin
